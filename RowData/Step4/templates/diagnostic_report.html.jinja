<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ===== CSS变量定义区（按规范） ===== */
    :root {
            /* 主色调（高级中性色+金属点缀） */
            --color-primary: #1a2b4a;        /* 深海军蓝 */
            --color-secondary: #8b0000;      /* 深酒红 */
            --color-accent-gold: #d4af37;   /* 鎏金 */
            --color-accent-silver: #c0c0c0; /* 鎏银 */

            /* 中性与背景 */
            --color-ink: #0f172a;
            --color-muted: #475569;
            --color-paper: #f7f0dc;
            --color-paper-2: #f7f0dc;
            --color-white: #ffffff;
            --color-bg: #f7f0dc;           /* 鎏金底色（背景） */
            --color-text-main: #2c2416;    /* 深墨（正文） */
            --color-border: #e8e0d0;       /* 淡棕（边框） */
            --color-light-gold: #f5e8aa;   /* 浅金（无风险） */
            --color-copper: #d2691e;       /* 赤金（中风险） */
            --color-deep-ink: #2c2416;     /* 深墨（极高风险） */
            --color-safe: #1b7f3a;         /* 低风险（绿色） */

            /* 字体 */
            --font-serif: "Noto Serif SC", "STSong", "SimSun", serif;
            --font-sans: "Noto Sans SC", "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
            --font-display: "Playfair Display", "Times New Roman", serif;

            /* 字号 */
            --font-h1: clamp(2.0rem, 4.5vw, 2.6rem);
            --font-h2: clamp(1.35rem, 2.5vw, 1.8rem);
            --font-h3: clamp(1.10rem, 2.0vw, 1.25rem);
            --font-h4: clamp(0.98rem, 1.6vw, 1.10rem);
            --font-body: 1rem;
            --font-small: 0.9rem;

            /* 间距 */
            --gap-xs: 8px;
            --gap-sm: 16px;
            --gap-md: 24px;
            --gap-lg: 32px;
            --gap-xl: 40px;

            /* 边框与圆角 */
            --border-radius: 8px;
            --border-radius-lg: 12px;
            --border-thin: 1px solid var(--color-accent-gold);
            --border-soft: 1px solid var(--color-border);
            --table-border: 1px solid rgba(212, 175, 55, 0.3);
            --table-border-vertical: 1px solid rgba(232, 224, 208, 0.5);

            /* 阴影 */
            --shadow-card: 0 2px 8px rgba(0, 0, 0, 0.08);

            /* 组件色 */
            --bg-soft: rgba(248, 245, 240, 0.8);
            --bg-gold-soft: rgba(212, 175, 55, 0.10);
            --bg-primary-soft: rgba(26, 43, 74, 0.10);

            /* 线条/透明度（用于避免硬编码 rgba） */
            --color-transparent: rgba(255, 255, 255, 0);
            --color-primary-border: rgba(26, 43, 74, 0.18);
            --color-line-dash: rgba(15, 23, 42, 0.12);
            --color-chip-border: rgba(15, 23, 42, 0.16);
            --color-chip-bg: rgba(15, 23, 42, 0.04);
            --color-shadow-ink-06: rgba(15, 23, 42, 0.06);
            --color-shadow-ink-08: rgba(15, 23, 42, 0.08);

            /* 透明背景/边框（避免硬编码 rgba） */
            --bg-white-soft: rgba(255, 255, 255, 0.6);
            --bg-info: rgba(248, 245, 240, 0.6);
            --bg-card-soft: rgba(248, 245, 240, 0.95);
            --bg-danger-soft: rgba(139, 0, 0, 0.08);
            --line-soft-black: rgba(0, 0, 0, 0.06);

                /* photoSample override helpers (keep colors inside :root per Step4 rule) */
                --photo-shadow-1: 0 1px 6px var(--color-shadow-ink-06);
                --photo-shadow-2: 0 1px 10px var(--color-shadow-ink-08);
                --photo-border: 1px solid var(--color-border);
                --photo-cover-grad-top: rgba(26, 43, 74, 0.06);
                --photo-cover-grad-bottom: rgba(255, 255, 255, 0.98);
                --photo-pill-danger-border: rgba(139, 0, 0, 0.25);
                --photo-pill-danger-bg: rgba(139, 0, 0, 0.06);
                --photo-pill-primary-border: rgba(26, 43, 74, 0.22);
                --photo-pill-primary-bg: rgba(26, 43, 74, 0.06);
                --photo-table-head-sep: rgba(255, 255, 255, 0.08);
                --photo-table-row-alt: rgba(26, 43, 74, 0.03);
                --photo-kv-border: rgba(26, 43, 74, 0.12);
                --photo-kv-k-bg: rgba(26, 43, 74, 0.04);
                    --photo-primary-border-12: rgba(26, 43, 74, 0.12);
                    --photo-subtitle-border: rgba(212, 175, 55, 0.35);
                --heatmap-head-bg: #1f2a44;
                --heatmap-ink: #2a2417;
                --heatmap-deep: #1f2a44;
                --heatmap-copper: #c5743a;
                --heatmap-silver: #c9c9c9;
                --heatmap-gold: #f4e7b1;
                --heatmap-label-bg: #f6f1e3;
                --heatmap-dot-shadow: rgba(0, 0, 0, 0.2);
    }

          /* ===== 通用样式区 ===== */
          html, body {
            margin: 0;
            padding: 0;
            background: var(--color-bg);
            color: var(--color-text-main);
          }
          body {
            font-family: var(--font-sans);
            line-height: 1.55;
          }

          .report-wrap {
            max-width: 980px;
            margin: 0 auto;
            padding: 32px 18px 64px;
          }

          .card {
            background: var(--color-paper);
            border: var(--border-soft);
            border-radius: var(--border-radius);
            padding: var(--gap-lg);
            box-shadow: var(--shadow-card);
          }

          .compact-card {
            padding: var(--gap-md);
          }

          .compact-card .module-title {
            margin: var(--gap-md) 0 var(--gap-sm);
          }

          .compact-card .submodule-title {
            margin: var(--gap-sm) 0 var(--gap-xs);
          }

          .compact-card .data-table,
          .compact-card .heatmap-table {
            margin: var(--gap-sm) 0;
          }

          .keep-together {
            break-inside: avoid;
            page-break-inside: avoid;
          }

          .keep-together.page-break {
            break-before: page;
            page-break-before: always;
          }

          .risk-dist-table {
            font-size: 0.85rem;
          }
          .risk-dist-table th,
          .risk-dist-table td {
            padding: 6px 8px;
            line-height: 1.4;
          }

          .risk-dist-table caption {
            caption-side: top;
            text-align: left;
            font-family: var(--font-serif);
            color: var(--color-primary);
            font-weight: 600;
            margin-bottom: var(--gap-xs);
          }

          .planA-table {
            break-inside: auto;
            page-break-inside: auto;
          }

          .planA-table caption {
            caption-side: top;
            text-align: left;
            font-family: var(--font-serif);
            color: var(--color-primary);
            font-weight: 600;
            margin-bottom: var(--gap-xs);
          }

          .planA-card {
            break-inside: auto;
            page-break-inside: auto;
          }

          .a4-page,
          .card,
          .data-table,
          .heatmap-table {
            break-inside: avoid;
            page-break-inside: avoid;
          }

          /* ===== 组件样式区 ===== */
          .cover {
            /* Keep base cover background transparent; cover background is defined by the photoSample override.
               This avoids a visible "white" layer behind the gold cover. */
            background: transparent;
            border: var(--border-soft);
            border-radius: var(--border-radius-lg);
            padding: var(--gap-lg);
            margin-bottom: var(--gap-md);
            position: relative;
            overflow: hidden;
            text-align: center;
          }

          /* Cover page: vertically center within an A4 page */
          .a4-page[data-page="m1"] {
            min-height: 297mm;
            display: flex;
            align-items: center;
            justify-content: center;
          }
          .a4-page[data-page="m1"] .cover {
            width: 100%;
          }

          /* 桌面端/平板端布局（首选） */
          .cover-top-row {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 20px;
            width: 100%;
            margin-bottom: var(--gap-lg);
            position: relative;
            min-height: 80px;
          }

          .family-badge {
            width: 80px;
            height: 80px;
            border-radius: 999px;
            background: var(--color-primary);
            border: 2px solid var(--color-accent-gold);
            box-shadow: var(--shadow-card);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-white);
            font-family: var(--font-display);
            font-weight: 700;
            letter-spacing: 0.6px;
          }

          .report-id {
            font-family: var(--font-serif);
            color: var(--color-accent-gold);
            text-align: center;
            font-weight: 700;
            letter-spacing: 0.3px;
            line-height: 2.2;
          }

          .cover-meta {
            margin: var(--gap-sm) 0 0;
            color: var(--color-muted);
            font-size: var(--font-small);
            line-height: 2.8;
            margin-bottom: 28px;
          }

          .cover-tagline {
            margin-top: 28px;
            text-align: center;
            font-family: var(--font-serif);
            color: var(--color-accent-gold);
            font-weight: 700;
            letter-spacing: 0.08em;
            line-height: 2.4;
          }

          .diagnosis-info {
            margin-top: var(--gap-sm);
            padding: var(--gap-sm);
            border: var(--border-thin);
            border-radius: var(--border-radius);
            background: var(--bg-info);
            text-align: center;
            font-size: var(--font-small);
            color: var(--color-primary);
            font-family: var(--font-sans);
          }
          .confidential {
            display: inline-block;
            margin-top: var(--gap-xs);
            padding: 6px 12px;
            border-radius: 999px;
            border: var(--border-thin);
            background: var(--bg-danger-soft);
            color: var(--color-secondary);
            font-family: var(--font-serif);
            letter-spacing: 0.4px;
          }

          h1 {
            margin: 0 0 var(--gap-xs);
            font-size: var(--font-h1);
            letter-spacing: 0.4px;
            font-family: var(--font-serif);
            color: var(--color-primary);
            line-height: 2.2;
          }
          .subtitle {
            margin: 0;
            color: var(--color-muted);
            font-size: var(--font-small);
            line-height: 2.4;
          }

          .module-title {
            font-family: var(--font-serif);
            font-size: var(--font-h3);
            color: var(--color-primary);
            padding-left: var(--gap-sm);
            border-left: 4px solid var(--color-accent-gold);
            margin: var(--gap-lg) 0 var(--gap-sm);
            position: relative;
          }

          .submodule-title {
            font-family: var(--font-serif);
            font-size: var(--font-h4);
            color: var(--color-primary);
            margin: var(--gap-md) 0 var(--gap-sm);
            font-weight: 600;
          }

          .module-label {
            display: inline-block;
            margin-right: var(--gap-sm);
            padding: 3px 10px;
            border-radius: 999px;
            border: 1px solid var(--color-chip-border);
            background: var(--color-chip-bg);
            font-size: var(--font-small);
            color: var(--color-muted);
            vertical-align: middle;
          }

          .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-md); }
          .kv { display: grid; grid-template-columns: 150px 1fr; gap: 8px 12px; }
          .k { color: var(--color-muted); }
          .v { font-weight: 600; }

          .data-table {
            width: 100%;
            border-collapse: collapse;
            margin: var(--gap-md) 0;
            font-size: var(--font-small);
            border: 1px solid var(--photo-subtitle-border); /* 金色外框（与内部线条一致） */
            background: var(--color-paper);
          }
          .data-table th,
          .data-table td {
            border: 1px solid var(--photo-subtitle-border);
            padding: var(--gap-sm);
            vertical-align: top;
          }
          .data-table th {
            background-color: transparent;
            color: var(--color-ink);
            font-family: var(--font-serif);
            text-align: center;
            font-weight: 700;
          }
          .data-table .text-right { text-align: right; }
          .data-table .group-cell {
            background: var(--bg-primary-soft);
            font-weight: 700;
            color: var(--color-primary);
          }

          .pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            border: var(--border-soft);
            background: var(--color-chip-bg);
            font-size: var(--font-small);
            color: var(--color-muted);
          }

          .score {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--color-primary);
            font-family: var(--font-display);
          }

          .muted { color: var(--color-muted); }
          .small { font-size: var(--font-small); }

          .toc a { color: inherit; text-decoration: none; }
          .toc a:hover { text-decoration: underline; }
          .toc-item {
            display: flex;
            justify-content: space-between;
            gap: var(--gap-md);
            padding: var(--gap-sm) 0;
            border-bottom: 1px dashed var(--color-line-dash);
          }

          .toc-family {
            font-family: var(--font-serif);
            color: var(--color-accent-gold);
            letter-spacing: 0.6px;
            margin-bottom: var(--gap-sm);
            text-align: right;
          }

          .toc-list {
            list-style: none;
            padding: 0;
            margin: var(--gap-sm) 0 0;
          }
          .toc-list li {
            padding: 8px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px dashed var(--color-line-dash);
          }
          .toc-dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: var(--color-accent-gold);
            display: inline-block;
            margin-right: 10px;
            flex: 0 0 auto;
          }
          .toc-left { display: flex; align-items: center; gap: 0; }

          .legend {
            margin-top: var(--gap-md);
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--gap-sm);
          }
          .legend-item {
            border: var(--border-soft);
            border-radius: var(--border-radius);
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg-white-soft);
          }
          .legend-swatch { width: 18px; height: 12px; border-radius: 3px; border: 1px solid var(--line-soft-black); }
          .legend-text { font-family: var(--font-serif); color: var(--color-primary); }
          .toc-title { font-weight: 650; }
          .toc-hint { color: var(--color-muted); font-size: var(--font-small); }

          /* 书信体问候区（P1） */
          .greeting {
            border: var(--border-thin);
            border-radius: var(--border-radius);
            padding: var(--gap-md);
            background-color: var(--bg-card-soft);
          }
          .greet-salutation { text-align: left; font-family: var(--font-serif); }
          .greet-body { text-indent: 2em; margin: var(--gap-sm) 0; }
          .greet-sign { text-align: right; color: var(--color-accent-gold); font-family: var(--font-serif); }

          /* 报告编制说明（特殊格式） */
          .report-info-card {
            border: 1px solid var(--photo-subtitle-border);
            border-radius: var(--border-radius);
            padding: var(--gap-md);
            background-color: var(--color-paper);
          }
              .copyright-info {
                margin-top: var(--gap-md);
                padding: var(--gap-sm);
                font-size: 0.85rem;
                color: var(--color-accent-gold);
                letter-spacing: 0.5px;
                line-height: 1.5;
                font-family: var(--font-serif);
                text-align: center;
              }
              .copyright-info::before { content: "© "; }
          .info-item {
            margin-bottom: var(--gap-sm);
            padding-bottom: var(--gap-sm);
            border-bottom: none;
            text-align: center; /* 分行居中 */
          }
          .report-info-card .info-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
          }
          .info-title {
            font-family: var(--font-serif);
            color: var(--color-secondary);
            font-size: 1rem;
            margin-bottom: var(--gap-xs);
          }
          .info-content {
            font-family: var(--font-sans);
            color: var(--color-primary);
            font-size: var(--font-small);
          }

          /* ===== 响应式样式区 ===== */
          @media (max-width: 768px) { /* 移动端 */
            .cover-top-row {
              flex-direction: column;
              align-items: center;
              gap: var(--gap-sm);
            }
            .report-id {
              position: static;
              text-align: center;
              order: 2;
            }
            .grid { grid-template-columns: 1fr; }
            .kv { grid-template-columns: 1fr; }
            .legend { grid-template-columns: 1fr 1fr; }
          }
          @media (min-width: 769px) and (max-width: 1024px) { /* 平板端 */
            .report-wrap { padding: 28px 16px 56px; }
          }

          /* ===== 打印样式区（必须包含） ===== */
          @media print {
            @page { size: A4; margin: 0; }
            body { background: var(--color-paper); }
            .report-wrap { padding: 0; }
            .card, .cover { box-shadow: none; }
            a { color: inherit; text-decoration: none; }

            /* A4分页：每个模块单独起页（避免双重分页导致空白页） */
            .a4-page { page-break-after: always; break-after: page; min-height: auto; box-sizing: border-box; }
            .a4-page:last-child { page-break-after: auto; break-after: auto; }


            .a4-page[data-page="m1"] { height: 297mm; display: flex; align-items: center; justify-content: center; overflow: hidden; }
            .a4-page[data-page="m1"] .cover {
              width: 100%;
              height: auto;
              margin-bottom: 0;
              box-sizing: border-box;
              padding: 18mm 16mm;
            }
            .a4-page[data-page="m1"] .cover-top-row { gap: 12px; margin-bottom: 12px; min-height: 0; }
            .a4-page[data-page="m1"] h1 { line-height: 1.6; margin-bottom: 6px; }
            .a4-page[data-page="m1"] .subtitle { line-height: 1.8; }
            .a4-page[data-page="m1"] .cover-meta { line-height: 2.2; margin-bottom: 12px; }
            .a4-page[data-page="m1"] .cover-tagline { margin-top: 16px; line-height: 2.2; }


            /* 避免标题落在页尾 */
            .module-title, .submodule-title { break-inside: avoid; page-break-inside: avoid; }

            /* 打印表格优化（允许分页且重复表头） */
            thead { display: table-header-group; }
            tfoot { display: table-footer-group; }
            tr { break-inside: avoid; page-break-inside: avoid; }
          }

          /* ===== photoSample 版式覆写（更贴近截图样式：海军蓝 + 鎏金点缀） ===== */
          body {
            background: var(--color-bg);
            color: var(--color-ink);
          }

          .report-wrap {
            /* photoSample: content width ≈3172px @ 3x DPR => ~1058 CSS px */
            max-width: 1058px;
            padding: 28px 0 64px;
          }

          .page {
            display: grid;
            gap: 14px;
          }

          .card {
            border: var(--photo-border);
            box-shadow: var(--photo-shadow-1);
          }

          .cover {
            border: var(--photo-border);
            box-shadow: var(--photo-shadow-2);
            background: var(--color-bg);
          }
          .card,
          .cover {
            background: var(--color-bg);
            border: 1px solid transparent;
            box-shadow: none;
          }
          .a4-page[data-page="m3"] .card {
            background: var(--color-bg);
            border: 1px solid var(--photo-subtitle-border);
            border-top: none;
            box-shadow: none;
          }
          .a4-page[data-page="m3"] {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 297mm;
          }
          .a4-page[data-page="m3"] .card {
            width: calc(100% - 36px);
            margin: 0 auto;
          }
          .a4-page[data-page="m2"] {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 297mm;
          }
          .a4-page[data-page="m2"] .card {
            width: calc(100% - 36px);
            margin: 0 auto;
          }

          .cover-top-row {
            align-items: center;
          }

          .family-badge {
            width: 44px;
            height: 44px;
            border-radius: 999px;
            background: var(--color-ink);
            color: var(--color-white);
            display: grid;
            place-items: center;
            font-weight: 700;
            letter-spacing: 0.06em;
          }

          .report-id {
            position: absolute;
            top: 0;
            right: 0;
            font-family: var(--font-sans);
            color: var(--color-accent-gold);
            font-weight: 600;
            letter-spacing: 0.02em;
          }

          .cover h1 {
            font-family: var(--font-serif);
            letter-spacing: 0.06em;
          }

          .subtitle {
            color: var(--color-muted);
          }

          .module-title {
            font-family: var(--font-serif);
            font-weight: 700;
            color: var(--color-ink);
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            letter-spacing: 0.02em;
          }
          .module-title::before {
            content: "";
            width: 4px;
            height: 18px;
            background: var(--color-accent-gold);
            border-radius: 6px;
            display: inline-block;
            box-shadow: 0 0 0 1px var(--color-accent-gold);
          }

          .submodule-title {
            background: transparent;
            color: var(--color-ink);
            padding: 6px 0 6px 12px;
            border-radius: 0;
            border-left: 4px solid var(--color-accent-gold);
            letter-spacing: 0.02em;
            font-family: var(--font-serif);
            font-weight: 600;
          }

          .toc-list li {
            border-bottom: 1px dashed var(--color-primary-border);
            padding: 10px 0;
          }

          .pill {
            border: 1px solid var(--color-primary-border);
            background: var(--bg-white-soft);
          }

          .cover-pills {
            margin-top: 10px;
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
          }
          .pill--danger {
            border-color: var(--photo-pill-danger-border);
            background: var(--photo-pill-danger-bg);
            color: var(--color-secondary);
            font-weight: 700;
          }
          .pill--primary {
            border-color: var(--photo-pill-primary-border);
            background: var(--photo-pill-primary-bg);
            color: var(--color-primary);
            font-weight: 700;
          }

          .score {
            color: var(--color-secondary);
            font-weight: 800;
          }

          .data-table {
            border: 1px solid var(--photo-primary-border-12);
            border-radius: 10px;
            overflow: hidden;
          }

          .data-table thead th {
            background: transparent;
            color: var(--color-ink);
            border-right: 1px solid var(--photo-table-head-sep);
          }

          .data-table tbody tr:nth-child(even) td {
            background: var(--photo-table-row-alt);
          }

          .kv {
            border: 1px solid var(--photo-kv-border);
            border-radius: 10px;
            overflow: hidden;
          }
          .kv .k {
            background: var(--photo-kv-k-bg);
            color: var(--color-ink);
          }

          /* ===== 风险诊断可视化（极简条形） ===== */
          .viz-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: var(--gap-sm);
          }
          .viz-row {
            display: grid;
            grid-template-columns: 180px 1fr 92px;
            gap: 12px;
            align-items: center;
          }
          .viz-label { font-weight: 600; color: var(--color-ink); }
          .viz-bar {
            --pct: 0%;
            --bar-color: var(--color-border);
            height: 12px;
            background: var(--color-chip-bg);
            border: 1px solid var(--photo-primary-border-12);
            border-radius: 999px;
            overflow: hidden;
            position: relative;
          }
          .viz-fill {
            height: 100%;
            width: var(--pct);
            background: var(--bar-color);
            border-radius: 999px;
          }
          .viz-value {
            font-weight: 800;
            text-align: right;
            letter-spacing: 0.2px;
          }
          .heatmap-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: var(--gap-sm);
            border: var(--border-soft);
            border-radius: 10px;
            overflow: hidden;
          }
          .heatmap-table th,
          .heatmap-table td {
            border: 1px solid var(--color-border);
            padding: 10px 8px;
            text-align: center;
            font-size: 0.95rem;
          }
          .heatmap-table thead th {
            background: var(--heatmap-head-bg);
            color: var(--color-white);
            font-weight: 700;
          }
          .heatmap-table .heatmap-label {
            background: var(--heatmap-label-bg);
            color: var(--color-ink);
            font-weight: 600;
            text-align: left;
          }
          .heatmap-cell { position: relative; }
          .heatmap-gold { background: var(--heatmap-gold); }
          .heatmap-silver { background: var(--heatmap-silver); }
          .heatmap-copper { background: var(--heatmap-copper); }
          .heatmap-deep { background: var(--heatmap-deep); }
          .heatmap-ink { background: var(--heatmap-ink); }
          .heatmap-dot {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 999px;
            background: var(--color-white);
            box-shadow: 0 0 0 2px var(--heatmap-dot-shadow) inset;
          }
          .heatmap-dot.dark { background: var(--heatmap-ink); }
          @media (max-width: 720px) {
            .viz-row { grid-template-columns: 1fr; }
            .viz-value { text-align: left; }
          }

          /* ===== 打印覆盖（确保分页不会被版式 padding 挤出） ===== */
          @media print {
            .report-wrap { padding: 0; }
          }
  </style>
</head>
<body>
  {# Backward-compatible defaults (avoid UndefinedError if server didn't restart) #}
  {% if family_name is not defined %}{% set family_name = 'XXX家族' %}{% endif %}
  {% if family_abbr is not defined %}{% set family_abbr = 'XX' %}{% endif %}
  {% if family_badge_text is not defined %}{% set family_badge_text = 'FH' %}{% endif %}
  {% if system_name is not defined %}{% set system_name = '道易天枢诊断系统' %}{% endif %}
  {% if report_period is not defined %}{% set report_period = '2026.Q1' %}{% endif %}
  {% if advisor_group is not defined %}{% set advisor_group = '道易天枢家族传承专家组' %}{% endif %}
  {% if top_singularity_chain is not defined %}{% set top_singularity_chain = '—' %}{% endif %}
  {% if risk_level is not defined %}{% set risk_level = {'label': '未评估', 'color': 'var(--color-border)'} %}{% endif %}
  {% if respondent_display is not defined %}{% set respondent_display = None %}{% endif %}
  {% if metrics is not defined %}{% set metrics = {} %}{% endif %}
  {% if planA_enabled is not defined %}{% set planA_enabled = false %}{% endif %}
  {% if planA_analysis is not defined %}{% set planA_analysis = None %}{% endif %}
  {% if planA_error is not defined %}{% set planA_error = None %}{% endif %}
  {% if planA_pdf is not defined %}{% set planA_pdf = None %}{% endif %}
  {% if planA_html is not defined %}{% set planA_html = None %}{% endif %}
  {% if planA_json is not defined %}{% set planA_json = None %}{% endif %}
  {% if planA_links is not defined %}{% set planA_links = {} %}{% endif %}
  {% if planA_table is not defined %}{% set planA_table = None %}{% endif %}
  {% if planA_table_error is not defined %}{% set planA_table_error = None %}{% endif %}
  {% if planA_health is not defined %}{% set planA_health = None %}{% endif %}
  {% if planA_health_error is not defined %}{% set planA_health_error = None %}{% endif %}
  {% if company_market is not defined %}{% set company_market = None %}{% endif %}
  {% if company_symbol is not defined %}{% set company_symbol = None %}{% endif %}
  {% if company_period is not defined %}{% set company_period = None %}{% endif %}

  <div class="report-wrap">
    <!-- 模块1: 报告封面 -->
    <div class="a4-page" data-page="m1">
      <section class="cover" id="m1">
        <div class="cover-top-row">
          <div class="family-badge">{{ family_badge_text }}</div>
        </div>
        <h1>{{ title }}</h1>
        <p class="subtitle">{{ system_name }} · {{ report_period }}</p>
        <p class="cover-meta">
          {{ family_name }}
          {% if respondent_display %} · 受访者：{{ respondent_display }}{% endif %}
          · 专属顾问团：{{ advisor_group }}
        </p>

        <div class="cover-tagline">传的是血脉，承的是文明</div>
      </section>
    </div>

    <!-- 模块2: 报告目录 -->
    {% if toc_modules and toc_modules|length > 0 %}
    <div class="a4-page" data-page="m2">
      <section class="card" id="m2">
        <div class="module-title">报告目录</div>
        <div class="toc-family">{{ family_name }}</div>
        <ul class="toc-list">
          {% for module in toc_modules %}
            <li>
              <div class="toc-left">
                <span class="toc-dot"></span>
                <span class="toc-title">{{ module.title }}</span>
              </div>
              <a class="toc-hint" href="#{{ module.key }}">跳转</a>
            </li>
          {% endfor %}
        </ul>
      </section>
    </div>
    {% endif %}

    <!-- 模块3: 核心诊断摘要 -->
    <div class="a4-page" data-page="m3">
      <section class="card" id="m3">
        <div class="module-title">一、核心诊断摘要</div>
      <div class="greeting" style="margin-bottom: var(--gap-md);">
        <div class="greet-salutation">致 {{ family_name }}核心成员：</div>
        <div class="greet-body muted">基于{{ system_name }}诊断体系，结合{{ family_name }}传承特性，现将专属风险诊断报告呈现如下。</div>
        <div class="greet-sign">道易天枢风险诊断专家团</div>
      </div>
      <div class="kv">
        <div class="k">作答题数</div>
        <div class="v">{{ answered_count }}/{{ total_count }}</div>
        {% if respondent_display %}
          <div class="k">受访者</div>
          <div class="v">{{ respondent_display }}</div>
        {% endif %}
        <div class="k">生成时间</div>
        <div class="v">{{ generated_at }}</div>
      </div>
      </section>
    </div>

    <div class="a4-page" data-page="m3b">
      <section class="card" id="m3b">
      <div class="submodule-title" style="margin-top: var(--gap-md);">（二）核心风险总览</div>
      {% if stage_b and stage_b.ok %}
        <table class="data-table">
          <thead>
            <tr>
              <th>项目</th>
              <th>结果</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>整体风险系数</td>
              <td><span class="score">{{ '%.1f' % stage_b.overall_score }}/100</span>（{{ risk_level.label }}）</td>
            </tr>
            <tr>
              <td>核心奇点类型</td>
              <td>
                <div>人物奇点、财富奇点、关系奇点、事件奇点</div>
                <div class="muted small" style="margin-top: 6px;">当前核心：{{ top_singularity_chain }}</div>
              </td>
            </tr>
            <tr>
              <td>致命共振风险</td>
              <td>
                {% if step3_materials and step3_materials.resonance_risks and step3_materials.resonance_risks|length > 0 %}
                  <span>
                    {% for r in step3_materials.resonance_risks %}
                      {{ r.name or '共振' }}{% if not loop.last %}、{% endif %}
                    {% endfor %}
                  </span>
                {% else %}
                  <span class="muted">—（Step3 未匹配到与当前核心奇点重叠的共振组合）</span>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>

        <div class="submodule-title" style="margin-top: var(--gap-md);">（三）关键指标量化</div>
        <table class="data-table">
          <thead>
            <tr>
              <th>量化项</th>
              <th>结果</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>662指标达标率</td>
              <td>
                {% if metrics and metrics.indicator_total %}
                  <span class="score">{{ '%.1f' % (metrics.indicator_pass_rate_pct or 0.0) }}%</span>
                  （{{ metrics.indicator_passed or 0 }}/{{ metrics.indicator_assessed or 0 }}）
                  <span class="muted">（覆盖{{ metrics.indicator_assessed or 0 }}项，占662项的{{ '%.1f' % (metrics.indicator_coverage_pct or 0.0) }}%）</span>
                {% else %}
                  <span class="muted">—%（—/662）（待接入完整 662 指标体系统计）</span>
                {% endif %}
              </td>
            </tr>
            <tr>
              <td>核心指标异常数</td>
              <td>
                {% if metrics and (metrics.core_abnormal_total is not none) %}
                  {% if (metrics.core_abnormal_high or 0) > 0 %}
                    <span class="score" style="color: var(--color-secondary); font-weight: 700;">{{ metrics.core_abnormal_total }}</span>
                  {% elif (metrics.core_abnormal_mid or 0) > 0 %}
                    <span class="score" style="color: var(--color-accent-gold); font-weight: 700;">{{ metrics.core_abnormal_total }}</span>
                  {% else %}
                    <span class="score">0</span>
                  {% endif %}
                  <span class="muted">（高风险{{ metrics.core_abnormal_high or 0 }}，中风险{{ metrics.core_abnormal_mid or 0 }}）</span>
                {% else %}
                  <span class="muted">—（待接入异常指标汇总）</span>
                {% endif %}
              </td>
            </tr>
            <tr>
              <td>传承韧性指标</td>
              <td>
                {% if metrics and (metrics.humanity_score is not none) %}
                  <span class="score">{{ '%.1f' % metrics.humanity_score }}/100</span>
                  <span class="muted">（人物奇点得分）</span>
                {% else %}
                  <span class="muted">—/100（待接入）</span>
                {% endif %}
              </td>
            </tr>
            <tr>
              <td>传导风险特征</td>
              <td>
                {% if step3_materials and step3_materials.summary and step3_materials.summary.conduction %}
                  <span class="muted">{{ step3_materials.summary.conduction.text }}</span>
                {% else %}
                  <span class="muted">—</span>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>

      {% else %}
        <p class="muted">阶段B未生成或失败。</p>
      {% endif %}
      </section>
    </div>

    <div class="a4-page" data-page="m4">
      <section class="card compact-card" id="m4">
        <div class="module-title">核心诊断摘要（续）</div>
        {% if stage_b and stage_b.ok %}
          <div class="submodule-title" style="margin-top: var(--gap-sm);">7类奇点得分明细</div>
          <table class="data-table risk-dist-table">
            <thead>
              <tr>
                <th>奇点类别</th>
                <th>得分（100分制）</th>
              </tr>
            </thead>
            <tbody>
              {% for name, score in stage_b.category_scores.items() %}
              <tr>
                <td>{{ name }}</td>
                <td>{{ '%.1f' % score }}/100</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>

        {% endif %}
      </section>
    </div>

    <!-- 模块5: 风险诊断可视化 -->
    <div class="a4-page" data-page="m5">
    <section class="card compact-card" id="m5" style="margin-top: var(--gap-sm);">
      <div class="module-title">风险诊断可视化</div>
      {% if stage_b and stage_b.ok %}
        <div class="submodule-title" style="margin-top: var(--gap-sm);">7类奇点风险热力图</div>
        <table class="heatmap-table">
          <thead>
            <tr>
              <th>奇点类型</th>
              <th>鎏金级（1-20分）</th>
              <th>鎏银级（21-40分）</th>
              <th>赤金级（41-60分）</th>
              <th>深海军蓝级（61-80分）</th>
              <th>墨玉级（81-100分）</th>
              <th>风险系数</th>
            </tr>
          </thead>
          <tbody>
            {% for name, score in stage_b.category_scores.items() %}
              {% set v = (score or 0.0) %}
              {% if v >= 81 %}
                {% set bucket = 'ink' %}
              {% elif v >= 61 %}
                {% set bucket = 'deep' %}
              {% elif v >= 41 %}
                {% set bucket = 'copper' %}
              {% elif v >= 21 %}
                {% set bucket = 'silver' %}
              {% else %}
                {% set bucket = 'gold' %}
              {% endif %}
              <tr>
                <td class="heatmap-label">{{ name }}</td>
                <td class="heatmap-cell heatmap-gold">{% if bucket == 'gold' %}<span class="heatmap-dot dark"></span>{% else %}—{% endif %}</td>
                <td class="heatmap-cell heatmap-silver">{% if bucket == 'silver' %}<span class="heatmap-dot dark"></span>{% else %}—{% endif %}</td>
                <td class="heatmap-cell heatmap-copper">{% if bucket == 'copper' %}<span class="heatmap-dot"></span>{% else %}—{% endif %}</td>
                <td class="heatmap-cell heatmap-deep">{% if bucket == 'deep' %}<span class="heatmap-dot"></span>{% else %}—{% endif %}</td>
                <td class="heatmap-cell heatmap-ink">{% if bucket == 'ink' %}<span class="heatmap-dot"></span>{% else %}—{% endif %}</td>
                <td>{{ '%.1f' % v }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% else %}
          <p class="muted">阶段B未生成或失败。</p>
        {% endif %}
        </section>
      </div>

    <div class="a4-page" data-page="m4b">
      <section class="card compact-card" id="m4b">
        <div class="keep-together">
          {% if stage_b and stage_b.ok %}
          {% set risk_desc_map = {
            '权力/决策奇点': '决策权过度集中、制衡机制不足',
            '认知/文化奇点': '规则共识不足，文化约束弱化',
            '时间奇点': '接班与代际安排滞后，节奏失衡',
            '人物奇点': '核心人物稳定性与能力结构波动',
            '财富奇点': '资产配置与隔离不足，财富脆弱',
            '关系奇点': '家族成员协同不足，信任下降',
            '事件奇点': '外部或突发事件冲击引发连锁'
          } %}
          {% set impact_map = {
            '权力/决策奇点': '决策质量、传承稳定性',
            '认知/文化奇点': '内部治理、权责分配',
            '时间奇点': '代际传承、企业延续',
            '人物奇点': '经营连续性、权力过渡',
            '财富奇点': '财富保值、业务可持续',
            '关系奇点': '内部凝聚力、战略一致性',
            '事件奇点': '资产安全、风险隔离'
          } %}
          {% set sorted_scores = stage_b.category_scores|dictsort(false, 'value')|reverse %}
          <table class="data-table risk-dist-table">
            <caption>（二）风险奇点分布表</caption>
            <thead>
              <tr>
                <th style="width: 60px;">序号</th>
                <th>风险描述</th>
                <th style="width: 160px;">对应奇点类型</th>
                <th style="width: 130px;">风险系数（100分制）</th>
                <th style="width: 110px;">风险等级</th>
                <th style="width: 180px;">影响范围</th>
              </tr>
            </thead>
            <tbody>
              {% for name, score in sorted_scores %}
                {% set v = score or 0.0 %}
                {% if v >= 81 %}
                  {% set level = '极高风险' %}
                {% elif v >= 61 %}
                  {% set level = '高风险' %}
                {% elif v >= 41 %}
                  {% set level = '中风险' %}
                {% elif v >= 21 %}
                  {% set level = '低风险' %}
                {% elif v > 0 %}
                  {% set level = '无风险' %}
                {% else %}
                  {% set level = '未评估' %}
                {% endif %}
                <tr>
                  <td>{{ loop.index }}</td>
                  <td>{{ risk_desc_map.get(name, '—') }}</td>
                  <td>{{ name }}</td>
                  <td>{{ '%.1f' % v }}</td>
                  <td>{{ level }}</td>
                  <td>{{ impact_map.get(name, '—') }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>
    </section>
    </div>

    <!-- 模块6: 风险传导链路 -->
    <div class="a4-page" data-page="m6">
    <section class="card" id="m6">
      <div class="module-title">风险传导链路</div>
      <div class="submodule-title">（一）传导链路可视化</div>
      <div class="report-info-card" style="margin-top: var(--gap-sm);">
        <div class="info-item">
          <div class="info-content" style="line-height: 1.9;">
            {% if step3_materials and step3_materials.conduction %}
              {% set conduction = step3_materials.conduction %}
              {% if step3_materials.summary and step3_materials.summary.conduction %}
                <p><strong>概览：</strong>{{ step3_materials.summary.conduction.text }}</p>
              {% endif %}

              {% if conduction.single_chain and conduction.single_chain|length > 0 %}
                <p><strong>1. 直接归因链（单链）</strong></p>
                <ul class="toc-list" style="margin: 0;">
                  {% for e in conduction.single_chain %}
                    <li>
                      <span>{{ e.src or '—' }} → {{ e.dst or '—' }}</span>
                      <span class="toc-hint">
                        {% if e.support_count is not none %}样本{{ e.support_count }}{% endif %}
                        {% if e.multiplier_max %}｜放大{{ '%.2f' % e.multiplier_max }}{% endif %}
                      </span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if conduction.multi_chains and conduction.multi_chains|length > 0 %}
                <p style="margin-top: var(--gap-sm);"><strong>2. 多链传导（候选{{ conduction.multi_chains|length }}条）</strong></p>
                <ul class="toc-list" style="margin: 0;">
                  {% for e in conduction.multi_chains %}
                    <li>
                      <span>{{ e.src or '—' }} → {{ e.dst or '—' }}</span>
                      <span class="toc-hint">{% if e.support_count is not none %}样本{{ e.support_count }}{% endif %}</span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if conduction.resonance_amplification and conduction.resonance_amplification|length > 0 %}
                <p style="margin-top: var(--gap-sm);"><strong>3. 共振放大链（{{ conduction.resonance_amplification|length }}条）</strong></p>
                <ul class="toc-list" style="margin: 0;">
                  {% for e in conduction.resonance_amplification %}
                    <li>
                      <span>{{ e.src or '—' }} → {{ e.dst or '—' }}</span>
                      <span class="toc-hint">{% if e.multiplier_max %}放大{{ '%.2f' % e.multiplier_max }}{% endif %}</span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if conduction.master_table and conduction.master_table|length > 0 %}
                <p style="margin-top: var(--gap-sm);"><strong>4. 核心传导总表（摘录）</strong></p>
                <ul class="toc-list" style="margin: 0;">
                  {% for row in conduction.master_table %}
                    <li>
                      <span>{{ row.chain or (row.src ~ '→' ~ row.dst) }}</span>
                      <span class="toc-hint">
                        {% if row.governance_node %}治理：{{ row.governance_node }}{% endif %}
                        {% if row.m_value %}｜M={{ row.m_value }}{% endif %}
                      </span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if (not conduction.single_chain or conduction.single_chain|length == 0)
                    and (not conduction.multi_chains or conduction.multi_chains|length == 0)
                    and (not conduction.master_table or conduction.master_table|length == 0) %}
                <p class="muted">暂无可用传导链路数据。</p>
              {% endif %}
            {% else %}
              <p class="muted">暂无可用传导链路数据。</p>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
    </div>

    <!-- 模块9: 报告详细解读与核心启示 -->
    <div class="a4-page" data-page="m9">
    <section class="card" id="m9">
      <div class="module-title">报告详细解读与核心启示</div>
      <p class="muted">用于将核心风险点与奇点类别进行叙事化解读（当前为结构占位）。</p>
      <div class="submodule-title" style="margin-top: var(--gap-md);">（二）传导链路注解</div>
      <div class="report-info-card" style="margin-top: var(--gap-sm);">
        <div class="info-item" style="margin-bottom: 0;">
          <div class="info-content" style="line-height: 1.9;">
            <p><strong>单链传导：</strong></p>
            <p>初始触发奇点多为根源性奇点（认知/文化、权力/决策），传导速度较快（3-12个月），关键节点集中于权力集中、规则缺失等核心问题，干预需聚焦源头奇点治理，如通过建立家族宪法阻断认知→权力传导。</p>
            <p><strong>多链传导：</strong></p>
            <p>链路关联性强，权力集中与规则缺失形成叠加效应，放大决策失误风险；资产隔离不足与地缘风险共振，加剧资产损失，干预需采取协同治理，同步优化股权结构与资产配置。</p>
            <p><strong>网络共振：</strong></p>
            <p>股权集中、接班人空缺、规则缺失三大奇点形成强耦合关系，因缺乏制衡机制与传承规划，风险非线性放大2.2倍，干预窗口期极短（3个月内），需紧急启动综合整改。</p>
          </div>
        </div>
      </div>
    </section>

    </div>

    {% if planA_enabled %}
    <!-- 模块9A: 财务分析 -->
    <div class="a4-page" data-page="m9a">
    <section class="card planA-card" id="m9a">
      <div class="module-title">财务分析</div>
      <p class="muted">当用户选择上市公司时，展示 PlanA 自动生成的财务摘要与表格。</p>

      <div class="kv" style="margin-top: var(--gap-sm);">
        <div class="k">市场</div>
        <div class="v">{{ company_market or '—' }}</div>
        <div class="k">代码</div>
        <div class="v">{{ company_symbol or '—' }}</div>
        <div class="k">报告期</div>
        <div class="v">{{ company_period or '—' }}</div>
      </div>

      {% if planA_analysis %}
        {% set _planA_analysis_unused = planA_analysis %}
      {% endif %}

      {% if planA_table or planA_table_error %}
        {% set _planA_table_unused = planA_table %}
        {% set _planA_table_error_unused = planA_table_error %}
      {% endif %}

      {% if planA_health %}
        <div class="report-info-card" style="margin-top: var(--gap-md);">
          <div class="info-item">
            <div class="info-title">财务健康分析</div>
            <div class="info-content">
              <p><strong>健康评分：</strong>{{ planA_health.score.overall }} / 100（{{ planA_health.score.grade }}）</p>
              <p><strong>结论：</strong>{{ planA_health.summary }}</p>
              {% if planA_health.signals.positive %}
                <p><strong>优势：</strong>{{ planA_health.signals.positive | join('、') }}</p>
              {% endif %}
              {% if planA_health.signals.risk %}
                <p><strong>风险提示：</strong>{{ planA_health.signals.risk | join('、') }}</p>
              {% endif %}
              {% if planA_health.dcf and planA_health.dcf.ok %}
                <p><strong>DCF 估值：</strong>{{ planA_health.dcf.value_billion_cny | round(2) }} 亿（基于经营现金流估算）</p>
              {% elif planA_health.dcf and planA_health.dcf.reason %}
                <p><strong>DCF 估值：</strong>{{ planA_health.dcf.reason }}</p>
              {% endif %}
              {% if planA_health.models and planA_health.models.z_score %}
                <p><strong>破产风险指数：</strong>{{ planA_health.models.z_score.score }}（{{ planA_health.models.z_score.band }}，近似）</p>
              {% endif %}
              {% if planA_health.models and planA_health.models.f_score %}
                <p><strong>财务质量评分：</strong>{{ planA_health.models.f_score.score }}/9（近似）</p>
              {% endif %}
              {% if planA_health.models %}
                <p class="muted small">破产风险指数越低风险越高；财务质量评分越高越稳健。</p>
              {% endif %}

              <div style="margin-top: var(--gap-sm);"></div>
              <p><strong>财务质量关键指标与公式</strong></p>
              <p class="muted small">以下指标用于解释“为何财务质量高或低”，并直接影响评分。</p>
              <table class="data-table" style="margin-top: var(--gap-xs);">
                <thead>
                  <tr>
                    <th style="text-align:left;">指标</th>
                    <th>数值</th>
                    <th style="text-align:left;">公式/说明</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>资产负债率</td>
                    <td class="text-right">{{ planA_health.ratios.debt_to_assets_pct | round(2) }}%</td>
                    <td>总负债 / 总资产</td>
                  </tr>
                  <tr>
                    <td>净利率</td>
                    <td class="text-right">{{ planA_health.ratios.net_margin_pct | round(2) }}%</td>
                    <td>净利润 / 营业收入</td>
                  </tr>
                  <tr>
                    <td>ROE</td>
                    <td class="text-right">{{ planA_health.ratios.roe_pct | round(2) }}%</td>
                    <td>净利润 / 所有者权益</td>
                  </tr>
                  <tr>
                    <td>经营现金流</td>
                    <td class="text-right">{{ planA_health.ratios.operating_cf | round(2) }}</td>
                    <td>为正代表主营业务现金回收良好</td>
                  </tr>
                  <tr>
                    <td>经营现金流/净利润</td>
                    <td class="text-right">{{ planA_health.ratios.ocf_np_ratio | round(2) }}</td>
                    <td>经营现金流 / 净利润</td>
                  </tr>
                  <tr>
                    <td>营收同比</td>
                    <td class="text-right">{{ planA_health.ratios.revenue_yoy_pct | round(2) }}%</td>
                    <td>增长为正代表业务扩张</td>
                  </tr>
                  <tr>
                    <td>净利润同比</td>
                    <td class="text-right">{{ planA_health.ratios.net_profit_yoy_pct | round(2) }}%</td>
                    <td>增长为正代表盈利质量改善</td>
                  </tr>
                </tbody>
              </table>

              <p style="margin-top: var(--gap-sm);"><strong>评分构成</strong></p>
              <table class="data-table" style="margin-top: var(--gap-xs);">
                <thead>
                  <tr>
                    <th style="text-align:left;">维度</th>
                    <th>得分</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>杠杆水平</td>
                    <td class="text-right">{{ planA_health.score.components.leverage | round(1) }}</td>
                  </tr>
                  <tr>
                    <td>盈利能力</td>
                    <td class="text-right">{{ planA_health.score.components.profitability | round(1) }}</td>
                  </tr>
                  <tr>
                    <td>ROE 得分</td>
                    <td class="text-right">{{ planA_health.score.components.roe | round(1) }}</td>
                  </tr>
                  <tr>
                    <td>现金流</td>
                    <td class="text-right">{{ planA_health.score.components.cashflow | round(1) }}</td>
                  </tr>
                  <tr>
                    <td>增长</td>
                    <td class="text-right">{{ planA_health.score.components.growth | round(1) }}</td>
                  </tr>
                </tbody>
              </table>

              {% if planA_health.yoy_series and planA_health.yoy_series.columns %}
                <p style="margin-top: var(--gap-sm);"><strong>近三年同比变化</strong></p>
                <table class="data-table" style="margin-top: var(--gap-xs);">
                  <thead>
                    <tr>
                      <th style="text-align:left;">指标</th>
                      {% for col in planA_health.yoy_series.columns %}
                        <th>{{ col }}</th>
                      {% endfor %}
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>营收同比(%)</td>
                      {% for v in planA_health.yoy_series.revenue %}
                        <td class="text-right">{{ v if v is not none else '—' }}</td>
                      {% endfor %}
                    </tr>
                    <tr>
                      <td>净利润同比(%)</td>
                      {% for v in planA_health.yoy_series.net_profit %}
                        <td class="text-right">{{ v if v is not none else '—' }}</td>
                      {% endfor %}
                    </tr>
                    <tr>
                      <td>经营现金流同比(%)</td>
                      {% for v in planA_health.yoy_series.operating_cf %}
                        <td class="text-right">{{ v if v is not none else '—' }}</td>
                      {% endfor %}
                    </tr>
                  </tbody>
                </table>
              {% endif %}

              {% if planA_health.summary_text %}
                <p style="margin-top: var(--gap-sm);"><strong>小结</strong></p>
                <div class="muted small">{{ planA_health.summary_text }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% elif planA_health_error %}
        <p class="muted small" style="margin-top: var(--gap-sm);">财务健康分析加载失败：{{ planA_health_error }}</p>
      {% endif %}

      {% if planA_error and not planA_analysis %}
        <div class="error" style="margin-top: var(--gap-sm);">PlanA 生成失败：{{ planA_error }}</div>
      {% endif %}

      {% if planA_pdf or planA_html or planA_json %}
        <div class="meta" style="margin-top: var(--gap-sm);">
          {% if planA_pdf %}
            <div>PDF：{% if planA_links.pdf %}<a href="{{ planA_links.pdf }}">{{ planA_pdf }}</a>{% else %}{{ planA_pdf }}{% endif %}</div>
          {% endif %}
          {% if planA_html %}
            <div>HTML：{% if planA_links.html %}<a href="{{ planA_links.html }}">{{ planA_html }}</a>{% else %}{{ planA_html }}{% endif %}</div>
          {% endif %}
          {% if planA_json %}
            <div>JSON：{% if planA_links.json %}<a href="{{ planA_links.json }}">{{ planA_json }}</a>{% else %}{{ planA_json }}{% endif %}</div>
          {% endif %}
        </div>
      {% endif %}
    </section>
    </div>
    {% endif %}

    <!-- 模块10: 报告编制说明 -->
    <div class="a4-page" data-page="m10">
    <section class="card" id="m10">
      <div class="module-title">报告编制说明</div>
      <div class="report-info-card">
        <div class="info-item">
          <div class="info-title">编制依据</div>
          <div class="info-content">道易天枢诊断系统 · Step4《家族传承诊断报告标准化输出规范》与HTML转换规范</div>
        </div>
        <div class="info-item">
          <div class="info-title">诊断团队</div>
          <div class="info-content">道易天枢诊断专家组</div>
        </div>
        <div class="info-item" style="margin-bottom: 0;">
          <div class="info-title">数据来源</div>
          <div class="info-content">道易天枢诊断系统662项指标体系、公开披露信息、家族治理相关文件</div>
        </div>
        <div class="info-item">
          <div class="info-title">免责声明</div>
          <div class="info-content">本报告基于道易天枢诊断系统与公开信息分析生成，仅供使用者进行传承风险识别与管理参考，不构成任何法律、财务或投资建议。家族传承规划需结合实际情况动态调整，建议在专业机构协助下完成方案设计与落地执行。</div>
        </div>
        <div class="info-item">
          <div class="info-title">版权声明</div>
          <div class="info-content">本报告及其全部内容为道易世家家族传承中心的专有知识产权，受法律保护，严禁任何形式的复制、传播、公开或用于商业目的，违者将依法追究法律责任。</div>
        </div>
      </div>

      <div class="copyright-info">道易世家家族传承中心 版权所有｜基于《道易天枢诊断系统》生成诊断报告｜版本号 V2.0</div>
    </section>
    </div>
  </div>
</body>
</html>
